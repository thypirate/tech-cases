# API URL used by the Next.js server (SSR and the /api proxy). On Railway, the private-network URL:
# http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
API_INTERNAL_URL=http://localhost:4000
# Same value as the API's INTERNAL_API_TOKEN (lets SSR calls skip the per-IP rate limit).
INTERNAL_API_TOKEN=

PORT=4000
# SQLite database file, relative to apps/api (created on first run).
# Railway: attach a volume to the api service at /data, then set DATABASE_PATH=/data/app.db and
# RAILWAY_RUN_UID=0 (see README, Deployment).
DATABASE_PATH=data/app.db
NODE_ENV=development
# Front-end origin, used for CORS
WEB_URL=http://localhost:3000

# Shared secret the web app sends on server-side calls so they skip the per-IP rate limit.
# Set the same value on the web service. Generate with `openssl rand -hex 32`.
INTERNAL_API_TOKEN=

{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/migrate.js && node dist/scripts/seed.js && node dist/index.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "seed": "node dist/scripts/seed.js",
    "seed:dev": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.3",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
